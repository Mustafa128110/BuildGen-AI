{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:auth": "node --import ./tests/support/register-types.mjs --test --test-isolation=none tests/auth/unit/*.test.mjs tests/platform/*.test.mjs",
    "test:auth-flow": "node --test --test-concurrency=1 tests/auth/integration/*.test.mjs",
    "test:auth-browser": "node --test --test-concurrency=1 tests/auth/browser/*.test.mjs",
    "test": "npm run test:auth && npm run test:features && npm run build && npm run test:auth-flow && npm run test:auth-browser && npm run test:features-browser",
    "test:boundaries": "node --import ./tests/support/register-types.mjs --test --test-isolation=none tests/platform/architecture.test.mjs tests/platform/registry.test.mjs",
    "test:features": "node --import ./tests/support/register-types.mjs --test --test-isolation=none tests/projects/unit/*.test.mjs tests/studio/unit/*.test.mjs tests/requirements/unit/*.test.mjs tests/drafting/unit/*.test.mjs tests/shared/unit/*.test.mjs",
    "prebuild": "npm run test:boundaries",
    "test:features-browser": "node --test --test-concurrency=1 tests/features/browser/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/pg": "^8.23.1",
    "gsap": "^3.15.0",
    "konva": "^10.9.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "^19.3.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
