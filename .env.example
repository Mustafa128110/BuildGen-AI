# =============================================================================
# BUILDGEN ENVIRONMENT CONFIGURATION (.env.example)
# Architectural AI-Native Design Engine & Workspace
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE (PostgreSQL Database, Auth & Realtime)
# -----------------------------------------------------------------------------
# Find these in your Supabase Dashboard: Settings -> API & Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Service role key (Keep secret! Only for server-side administrative routes/bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# Supabase PostgreSQL Connection String (Transaction Pooled - port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct PostgreSQL Connection String (For Alembic/Prisma migrations - port 5432)
DIRECT_URL="postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth JWT Secret (Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# -----------------------------------------------------------------------------
# 2. VERCEL DEPLOYMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Public canonical site URL for production and preview deployments
NEXT_PUBLIC_SITE_URL="https://buildgen.vercel.app"

# Vercel deployment environment (development, preview, production)
NEXT_PUBLIC_VERCEL_ENV="development"

# Vercel system variable (automatically injected by Vercel upon deployment)
# VERCEL_URL="your-deployment.vercel.app"

# Secret for securing Vercel Cron jobs or background trigger webhooks
CRON_SECRET="your-secure-random-cron-secret-32-chars"

# -----------------------------------------------------------------------------
# 3. BUILDGEN CORE API & FASTAPI BACKEND (Modular Monolith)
# -----------------------------------------------------------------------------
# Backend API route URL consumed by the Next.js client
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"

# Environment tier: development | staging | production
APP_ENV="development"

# Master application encryption key (minimum 32-byte secure random string)
SECRET_KEY="generate-secure-32-byte-hex-string-for-buildgen-core"

# Session signature and CSRF tokens (per Document B & C contracts)
SESSION_SECRET="generate-secure-session-secret-key-here"
CSRF_SECRET="generate-secure-csrf-secret-key-here"
REQUEST_HASH_SECRET="generate-secure-request-hash-secret-here"

# Session Time-To-Live in seconds (28800 = 8 hours)
SESSION_TTL_SECONDS=28800

# Cookie security flag: false for loopback/localhost development, true for HTTPS
COOKIE_SECURE=false

# CORS allowed frontend origin
ALLOWED_ORIGIN="http://localhost:3000"

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL="INFO"

# Private artifacts storage directory (IFC files, export bundles, revision logs)
DATA_DIR="./var/artifacts"

# -----------------------------------------------------------------------------
# 4. AI & SPATIAL MODEL PROVIDERS (Architectural Co-Pilot)
# -----------------------------------------------------------------------------
# Google Gemini API Key (Multimodal spatial reasoning and natural language CAD parsing)
GEMINI_API_KEY="your-gemini-api-key-here"

# OpenAI API Key (GPT-4o architectural brief parsing and layout assistance)
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Anthropic Claude API Key (Optional architectural reasoning)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"

# Hugging Face Token (For local/remote HouseDiffusion or Qwen2.5 weights)
HUGGINGFACE_API_TOKEN="hf_your-huggingface-token-here"

# -----------------------------------------------------------------------------
# 5. ARCHITECTURAL FEATURE GATES & CALIBRATION (Document B Contract)
# -----------------------------------------------------------------------------
# Enable ML spatial diffusion inference (false falls back to deterministic retrieval)
MODEL_ENABLED=true

# Enable Google OR-Tools bounded constraint solver (false uses basic layout)
REPAIR_ENABLED=true

# Enable IfcOpenShell BIM export (false disables IFC export menu)
IFC_ENABLED=true

# Enable automated Bill of Quantities schedule calculations
QUANTITIES_ENABLED=true

# Canonical architectural metric grid snap in millimeters (Standard: 10mm)
METRIC_GRID_SNAP_MM=10
