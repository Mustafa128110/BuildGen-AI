# Copy to .env.local for local development; keep real credentials out of Git.
# Supabase Dashboard -> Project Settings / API.
# Use the project origin (without /rest/v1) and a public anon/publishable key.
# Never use an sb_secret_ or service_role key for the account workflow.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"

# Existing NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY settings
# remain supported, but the server-only names above are preferred.
# Complete Email/Confirm email, Site URL and the confirmation template setup
# in docs/authentication.md. No real email delivery is configured by this file.
